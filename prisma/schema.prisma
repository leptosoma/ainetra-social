generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum GoalPriority {
  PRIMARY
  SECONDARY
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

enum SocialAccountStatus {
  CONNECTED
  DISCONNECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContentType {
  POST
  REEL
  STORY
  CAROUSEL
}

enum ContentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ScheduledPostStatus {
  SCHEDULED
  INVALIDATED
  CANCELLED
  PUBLISHED
  FAILED
}

enum PublishAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BusinessAnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum BusinessAttributeSource {
  USER
  WEBSITE
  INSTAGRAM
  AI_INFERENCE
  IMPORT
}

enum BusinessAttributeStatus {
  CONFIRMED
  INFERRED
  NEEDS_CONFIRMATION
  REJECTED
}

enum BusinessAttributeCategory {
  DESCRIPTION
  PRODUCTS_SERVICES
  TARGET_AUDIENCE
  LANGUAGE
  BRAND_TONE
  BRAND_PERSONALITY
  LOCATION_CONTEXT
  WEBSITE
  INSTAGRAM_IDENTITY
  BUSINESS_GOAL
  FACT
  RESTRICTION
  AVOID_WORD
  NOTE
}

enum PlatformRuleCategory {
  FREQUENCY
  FORMAT
  ASPECT_RATIO
  VIDEO_LENGTH
  HOOK
  SAFE_ZONE
  CAPTION
  CTA
  ORIGINALITY
  CONTENT_DIVERSITY
  POSTING_TIME
  AUDIO
  SUBTITLES
}

enum PlatformRecommendationType {
  TECHNICAL_REQUIREMENT
  BEST_PRACTICE
  GENERAL_RECOMMENDATION
  BUSINESS_LEARNED
}

enum PlatformRuleSource {
  OFFICIAL_PLATFORM
  VERIFIED_INTERNAL_ANALYSIS
  BUSINESS_PERFORMANCE
  MANUAL_ADMIN_RULE
}

enum ContentStrategyMode {
  AINETRA_RECOMMENDED
  CUSTOM
}

enum ContentPlanPeriod {
  SEVEN_DAYS
  THIRTY_DAYS
}

enum ContentPlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum ContentPlanItemStatus {
  ACTIVE
  REPLACED
}

enum ContentPlanningRunStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum MediaRequirement {
  PHOTO_PRODUCT
  PHOTO_ATMOSPHERE
  PHOTO_PEOPLE
  VIDEO_VERTICAL
  VIDEO_KITCHEN
  CUSTOM_GRAPHIC
  NO_NEW_MEDIA_REQUIRED
}

enum MediaAvailability {
  AVAILABLE
  MISSING
  NOT_REQUIRED
}

model User {
  id                          String                @id @default(cuid())
  name                        String
  email                       String                @unique
  passwordHash                String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  memberships                 Membership[]
  sessions                    Session[]
  approvals                   Approval[]
  analysisRuns                BusinessAnalysisRun[] @relation("AnalysisTriggeredBy")
  confirmedBusinessAttributes BusinessAttribute[]   @relation("AttributeConfirmedBy")
  approvedContentPlans        ContentPlan[]         @relation("ContentPlanApprovedBy")
  contentPlanningRuns         ContentPlanningRun[]  @relation("PlanningTriggeredBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id              String                @id @default(cuid())
  name            String
  sector          String
  location        String?
  website         String?
  instagramHandle String?
  timezone        String                @default("Europe/Istanbul")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  memberships     Membership[]
  brandProfile    BrandProfile?
  goals           BusinessGoal[]
  socialAccounts  SocialAccount[]
  mediaAssets     MediaAsset[]
  contentItems    ContentItem[]
  scheduledPosts  ScheduledPost[]
  aiInsights      AIInsight[]
  analysisRuns    BusinessAnalysisRun[]
  attributes      BusinessAttribute[]
  platformRules   PlatformRule[]
  contentStrategy ContentStrategy?
  contentPlans    ContentPlan[]
  planningRuns    ContentPlanningRun[]
}

model ContentPlanningRun {
  id            String                   @id @default(cuid())
  businessId    String
  triggeredById String
  period        ContentPlanPeriod
  scope         String
  provider      String
  model         String
  promptVersion String
  inputHash     String
  status        ContentPlanningRunStatus @default(PENDING)
  errorCode     String?
  createdAt     DateTime                 @default(now())
  completedAt   DateTime?
  business      Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  triggeredBy   User                     @relation("PlanningTriggeredBy", fields: [triggeredById], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([triggeredById, createdAt])
}

model PlatformRule {
  id                 String                     @id @default(cuid())
  businessId         String?
  platform           SocialPlatform
  contentType        ContentType?
  category           PlatformRuleCategory
  ruleKey            String
  value              Json
  recommendationType PlatformRecommendationType
  source             PlatformRuleSource
  sourceUrl          String?
  effectiveFrom      DateTime
  expiresAt          DateTime?
  reviewedAt         DateTime
  confidence         Float
  sectorScope        String[]                   @default([])
  active             Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  business           Business?                  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform, contentType, ruleKey, effectiveFrom])
  @@index([platform, active, effectiveFrom])
  @@index([businessId, platform, active])
}

model ContentStrategy {
  id                 String              @id @default(cuid())
  businessId         String              @unique
  mode               ContentStrategyMode @default(AINETRA_RECOMMENDED)
  platformSettings   Json
  contentMix         Json
  languages          String[]
  rationale          String
  userOverrideFields String[]            @default([])
  version            Int                 @default(1)
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plans              ContentPlan[]
}

model ContentPlan {
  id                 String            @id @default(cuid())
  businessId         String
  strategyId         String
  period             ContentPlanPeriod
  startDate          DateTime
  endDate            DateTime
  timezone           String
  version            Int               @default(1)
  status             ContentPlanStatus @default(DRAFT)
  strategySummary    String
  strategySnapshot   Json
  platformStrategies Json
  contentMix         Json
  provider           String
  model              String
  promptVersion      String
  inputHash          String
  approvedAt         DateTime?
  approvedById       String?
  supersedesId       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  strategy           ContentStrategy   @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  approvedBy         User?             @relation("ContentPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  supersedes         ContentPlan?      @relation("ContentPlanSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       ContentPlan[]     @relation("ContentPlanSupersession")
  items              ContentPlanItem[]

  @@unique([businessId, period, startDate, version])
  @@index([businessId, period, status, createdAt])
  @@index([strategyId])
  @@index([approvedById])
  @@index([supersedesId])
}

model ContentPlanItem {
  id                   String                @id @default(cuid())
  planId               String
  goalId               String
  platform             SocialPlatform
  contentType          ContentType
  plannedDate          DateTime
  recommendedTime      String
  pillar               String
  topic                String
  concept              String
  hookCategory         String
  hook                 String
  captionDirection     String
  cta                  String
  language             String
  mediaRequirement     MediaRequirement
  mediaAvailability    MediaAvailability
  mediaAssetId         String?
  reasoning            String
  platformRulesApplied Json
  revision             Int                   @default(1)
  status               ContentPlanItemStatus @default(ACTIVE)
  replacesItemId       String?
  contentItemId        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  plan                 ContentPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal                 BusinessGoal          @relation(fields: [goalId], references: [id], onDelete: Restrict)
  mediaAsset           MediaAsset?           @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  replacesItem         ContentPlanItem?      @relation("ContentPlanItemReplacement", fields: [replacesItemId], references: [id], onDelete: SetNull)
  replacementItems     ContentPlanItem[]     @relation("ContentPlanItemReplacement")
  contentItem          ContentItem?          @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([planId, status, plannedDate])
  @@index([goalId])
  @@index([mediaAssetId])
  @@index([replacesItemId])
  @@index([contentItemId])
}

model BusinessAnalysisRun {
  id             String                 @id @default(cuid())
  businessId     String
  triggeredById  String?
  provider       String
  model          String
  promptVersion  String
  inputSources   Json
  outputSnapshot Json?
  status         BusinessAnalysisStatus @default(PENDING)
  errorCode      String?
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  triggeredBy    User?                  @relation("AnalysisTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  attributes     BusinessAttribute[]

  @@index([businessId, status, createdAt])
  @@index([triggeredById])
}

model BusinessAttribute {
  id                 String                    @id @default(cuid())
  businessId         String
  analysisRunId      String?
  category           BusinessAttributeCategory
  key                String
  value              Json
  source             BusinessAttributeSource
  sourceReference    String?
  confidence         Float?
  verificationStatus BusinessAttributeStatus
  isCanonical        Boolean                   @default(false)
  supersedesId       String?
  confirmedAt        DateTime?
  confirmedById      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  analysisRun        BusinessAnalysisRun?      @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  supersedes         BusinessAttribute?        @relation("AttributeSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       BusinessAttribute[]       @relation("AttributeSupersession")
  confirmedBy        User?                     @relation("AttributeConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([businessId, key])
  @@index([businessId, category, verificationStatus])
  @@index([analysisRunId])
  @@index([supersedesId])
  @@index([confirmedById])
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole @default(MEMBER)
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model BrandProfile {
  id              String   @id @default(cuid())
  businessId      String   @unique
  description     String   @default("")
  targetAudience  String   @default("")
  languages       String[] @default(["tr"])
  productsSummary String   @default("")
  toneDimensions  Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessGoal {
  id         String            @id @default(cuid())
  businessId String
  type       String
  priority   GoalPriority
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content    ContentItem[]
  planItems  ContentPlanItem[]

  @@unique([businessId, type])
  @@index([businessId, priority])
}

model SocialAccount {
  id                String              @id @default(cuid())
  businessId        String
  platform          SocialPlatform
  displayName       String
  externalAccountId String?
  status            SocialAccountStatus @default(DISCONNECTED)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scheduledPosts    ScheduledPost[]

  @@index([businessId])
}

model MediaAsset {
  id               String            @id @default(cuid())
  businessId       String
  type             MediaType         @default(IMAGE)
  originalFilename String
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  storageKey       String            @unique
  tags             String[]          @default([])
  createdAt        DateTime          @default(now())
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants         ContentVariant[]
  planItems        ContentPlanItem[]

  @@index([businessId, createdAt])
}

model ContentItem {
  id          String            @id @default(cuid())
  businessId  String
  goalId      String?
  title       String
  topic       String
  contentType ContentType
  status      ContentStatus     @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goal        BusinessGoal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  variants    ContentVariant[]
  planItems   ContentPlanItem[]

  @@index([businessId, createdAt])
}

model ContentVariant {
  id              String          @id @default(cuid())
  contentItemId   String
  platform        SocialPlatform
  caption         String
  cta             String?
  language        String          @default("tr")
  mediaAssetId    String?
  aspectRatio     String?
  formatMetadata  Json            @default("{}")
  version         Int             @default(1)
  exportedAt      DateTime?
  exportedVersion Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contentItem     ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  approvals       Approval[]
  scheduledPosts  ScheduledPost[]

  @@unique([contentItemId, platform])
  @@index([mediaAssetId])
}

model Approval {
  id               String         @id @default(cuid())
  contentVariantId String
  approvedVersion  Int
  approvedById     String
  approvedAt       DateTime       @default(now())
  contentVariant   ContentVariant @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)
  approvedBy       User           @relation(fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([contentVariantId, approvedVersion])
  @@index([approvedById])
}

model ScheduledPost {
  id               String              @id @default(cuid())
  businessId       String
  socialAccountId  String
  contentVariantId String
  contentVersion   Int
  scheduledAt      DateTime
  status           ScheduledPostStatus @default(SCHEDULED)
  invalidatedAt    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  contentVariant   ContentVariant      @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)
  publishAttempts  PublishAttempt[]
  performance      PostPerformance?

  @@index([businessId, scheduledAt])
  @@index([status, scheduledAt])
}

model PublishAttempt {
  id              String               @id @default(cuid())
  scheduledPostId String
  status          PublishAttemptStatus @default(PENDING)
  errorCode       String?
  errorMessage    String?
  attemptedAt     DateTime             @default(now())
  scheduledPost   ScheduledPost        @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  @@index([scheduledPostId, attemptedAt])
}

model PostPerformance {
  id              String        @id @default(cuid())
  scheduledPostId String        @unique
  impressions     Int?
  engagements     Int?
  capturedAt      DateTime      @default(now())
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id         String   @id @default(cuid())
  businessId String
  kind       String
  message    String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
