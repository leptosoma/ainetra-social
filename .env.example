DATABASE_URL="postgresql://ainetra:ainetra_dev@localhost:55432/ainetra_social?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
LOCAL_STORAGE_ROOT=".data/uploads"
MAX_UPLOAD_BYTES="8388608"

# Optional structured text provider. Without these values the app uses the
# local grounded heuristic provider and still keeps the same validated contract.
BUSINESS_BRAIN_API_URL=""
BUSINESS_BRAIN_API_KEY=""
BUSINESS_BRAIN_MODEL=""

# P6-02 Meta connection (Facebook Login + Instagram API with Facebook Login). Leave empty to keep the
# connection disabled. Never commit real values. The redirect URI must exactly match the Meta app setting
# and use HTTPS (http://localhost is accepted for development only).
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""
META_GRAPH_API_VERSION="v26.0"
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Required to store Meta credentials.
META_CREDENTIAL_KEY=""
META_CREDENTIAL_KEY_ID="k1"
# Optional decrypt-only keys during rotation: "k0:base64,..."
META_CREDENTIAL_PREVIOUS_KEYS=""
