generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum GoalPriority {
  PRIMARY
  SECONDARY
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

enum SocialAccountStatus {
  CONNECTED
  DISCONNECTED
}

enum MetaOAuthAttemptStatus {
  PENDING
  PROCESSING
  AWAITING_SELECTION
  SELECTING
  COMPLETED
  FAILED
}

enum MetaConnectionAuditAction {
  CONNECT_STARTED
  CALLBACK_FAILED
  ASSETS_DISCOVERED
  SELECTION_FAILED
  CONNECTED
  RECONNECTED
  VALIDATED
  REAUTH_REQUIRED
  DISCONNECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContentType {
  POST
  REEL
  STORY
  CAROUSEL
}

enum ContentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ScheduledPostStatus {
  SCHEDULED
  INVALIDATED
  CANCELLED
  PUBLISHED
  FAILED
}

enum PublishAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  // P6-01: gönderim sağlayıcıya ulaşmış olabilir; sonuç ancak mutabakat ile belirlenir.
  UNKNOWN
}

// P6-01: PostgreSQL outbox satırının (PublishIntent) durumları. Geçiş kuralları tek bir
// domain modülünde tanımlıdır (src/features/publishing/intent-state.ts).
enum PublishIntentState {
  PENDING
  IN_FLIGHT
  UNKNOWN
  RETRY_WAIT
  PUBLISHED
  FAILED
  CANCELLED
  INVALIDATED
}

// P6-01: sağlayıcı sonucunun normalize edilmiş sınıfı.
enum PublishOutcomeClass {
  PUBLISHED
  RETRYABLE_REJECTION
  PERMANENT_REJECTION
  UNKNOWN
}

enum BusinessAnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum BusinessAttributeSource {
  USER
  WEBSITE
  INSTAGRAM
  AI_INFERENCE
  IMPORT
}

enum BusinessAttributeStatus {
  CONFIRMED
  INFERRED
  NEEDS_CONFIRMATION
  REJECTED
}

enum BusinessAttributeCategory {
  DESCRIPTION
  PRODUCTS_SERVICES
  TARGET_AUDIENCE
  LANGUAGE
  BRAND_TONE
  BRAND_PERSONALITY
  LOCATION_CONTEXT
  WEBSITE
  INSTAGRAM_IDENTITY
  BUSINESS_GOAL
  FACT
  RESTRICTION
  AVOID_WORD
  NOTE
}

enum PlatformRuleCategory {
  FREQUENCY
  FORMAT
  ASPECT_RATIO
  VIDEO_LENGTH
  HOOK
  SAFE_ZONE
  CAPTION
  CTA
  ORIGINALITY
  CONTENT_DIVERSITY
  POSTING_TIME
  AUDIO
  SUBTITLES
}

enum PlatformRecommendationType {
  TECHNICAL_REQUIREMENT
  BEST_PRACTICE
  GENERAL_RECOMMENDATION
  BUSINESS_LEARNED
}

enum PlatformRuleSource {
  OFFICIAL_PLATFORM
  VERIFIED_INTERNAL_ANALYSIS
  BUSINESS_PERFORMANCE
  MANUAL_ADMIN_RULE
}

enum ContentStrategyMode {
  AINETRA_RECOMMENDED
  CUSTOM
}

enum ContentPlanPeriod {
  SEVEN_DAYS
  THIRTY_DAYS
}

enum ContentPlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum ContentPlanItemStatus {
  ACTIVE
  REPLACED
}

enum ContentPlanningRunStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum MediaRequirement {
  PHOTO_PRODUCT
  PHOTO_ATMOSPHERE
  PHOTO_PEOPLE
  VIDEO_VERTICAL
  VIDEO_KITCHEN
  CUSTOM_GRAPHIC
  NO_NEW_MEDIA_REQUIRED
}

enum MediaAvailability {
  AVAILABLE
  MISSING
  NOT_REQUIRED
}

enum CaptureRequestStatus {
  OPEN
  FULFILLED
  DISMISSED
  EXPIRED
}

// Gerçek kullanımın hangi yaşam döngüsü sınırında kaydedildiğini söyler.
// EXPORTED = kullanıcı içeriği dışa aktarımını kaydetti; bu YAYINLANDI anlamına gelmez.
// Yayınlama (Phase 6) geldiğinde kendi değerini ekler.
enum MediaUsageType {
  EXPORTED
}

// Fallback önerisinin türü; sıralama product-bible "Content Fallback" listesiyle aynıdır.
// Bunlar kural tabanlı, deterministik önerilerdir; yapay zeka üretimi değildir.
enum ContentFallbackKind {
  UNUSED_AUTHENTIC_MEDIA
  OLDER_UNUSED_AUTHENTIC_MEDIA
  REUSABLE_AUTHENTIC_MEDIA
  FORMAT_ADAPTATION
  EXISTING_DESIGNED_CREATIVE
  CONFIRMED_BUSINESS_INFO
  VERIFIED_SOCIAL_PROOF
  BRAND_CREATIVE_PLACEHOLDER
}

enum ContentFallbackProposalStatus {
  PROPOSED
  ACCEPTED
  INVALIDATED
}

// P5-01 Görsel Analiz: bir MediaAsset için sürümlü analiz kayıtları. Analiz yalnızca medya
// meta verisidir; BusinessAttribute/BrandProfile/hedef gibi kanonik Business Brain durumunu
// asla değiştirmez. Gerçek sağlayıcı (REAL) ile geliştirme sağlayıcısı (DEVELOPMENT) ayrımı
// kayıt düzeyinde tutulur ve kullanıcıya görünür.
enum MediaAnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum MediaAnalysisProvenance {
  REAL
  DEVELOPMENT
}

enum VisualCategory {
  FOOD
  DRINK
  INTERIOR
  EXTERIOR
  PEOPLE
  TEAM
  PRODUCT
  SERVICE
  EVENT
  GRAPHIC
  OTHER
  UNKNOWN
}

enum MediaAssetOrigin {
  UPLOAD
  SAFE_ENHANCE
  BRAND_STYLE
  SOCIAL_VARIANT
  CREATIVE_CAMPAIGN
}

enum MediaEnhancementPreset {
  NATURAL
  BRIGHT
  CLEAN
  WARM
}

enum MediaEnhancementStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum MediaEnhancementDecision {
  KEPT
  DISCARDED
}

enum MediaEnhancementProvenance {
  REAL
  DEVELOPMENT
}

// P5-03 Marka Stili: kullanıcıya sunulan küçük seçim kümesi. BRAND_RECOMMENDED ("Markama göre")
// mevcut BrandProfile tercihlerinden türetilir; diğer üçü sabit, ölçülü alternatiflerdir.
// Bunlar Brand Style seçimleridir; kampanya/kreatif tasarım (P5-04) değildir.
enum MediaBrandStyleChoice {
  BRAND_RECOMMENDED
  NATURAL
  VIBRANT
  PREMIUM
}

enum MediaBrandStyleStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum MediaBrandStyleDecision {
  KEPT
  DISCARDED
}

enum MediaBrandStyleProvenance {
  REAL
  DEVELOPMENT
}

// Özgünlük sınırının hangi darlıkta uygulandığı. STRICT: gerçek ürün/kişi görünümü belgeleyen ya da
// doğrulanamamış görseller (varsayılan). STANDARD: hassas ama ürün rengi kritik olmayan görseller.
// RELAXED: analizin özgünlük açısından hassas bulmadığı görseller. Stil tercihi bu sınırı genişletemez.
enum MediaBrandStyleAuthenticityTier {
  RELAXED
  STANDARD
  STRICT
}

// P5-04 Sosyal Varyant: kullanıcıya sunulan basit format eylemleri. Bunlar Ainetra'nın eylem adlarıdır;
// hedef oran her zaman mevcut bir Platform Intelligence ASPECT_RATIO kuralından okunur, burada
// tanımlanmaz. Sosyal varyant teknik bir türevdir: kaynak özgünse çıktı da özgündür.
enum MediaSocialVariantFormat {
  FEED
  STORY
  REEL_COVER
  SQUARE
}

// COVER = güvenli merkez kırpma kurulabildi. CONTAIN = güvenli kırpma kurulamadı; fotoğrafın tamamı
// korunup boşluk düz renkle dolduruldu. Bu, konu tanıyan bir kırpma değildir; deterministik geometridir.
enum MediaSocialVariantFit {
  COVER
  CONTAIN
}

enum MediaSocialVariantStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum MediaSocialVariantDecision {
  KEPT
  DISCARDED
}

enum MediaSocialVariantProvenance {
  REAL
  DEVELOPMENT
}

// P5-04 Kreatif Kampanya: kasıtlı olarak küçük bir tasarım kümesi. Her kategori yalnızca KANONİK ve
// ONAYLI Business Brain bilgisiyle beslenir; bilgi yoksa kreatif üretilmez. Bu çıktılar tasarım
// görselidir ve hiçbir koşulda gerçek ürün/ekip/mekân fotoğrafı olarak sunulmaz.
enum MediaCreativeCategory {
  BUSINESS_INTRO
  PRODUCTS_SERVICES
  LOCATION_INFO
  CONFIRMED_FACTS
}

enum MediaCreativeStatus {
  PENDING
  SUCCEEDED
  FAILED
  INVALID_OUTPUT
}

enum MediaCreativeDecision {
  KEPT
  DISCARDED
}

enum MediaCreativeProvenance {
  REAL
  DEVELOPMENT
}

model User {
  id                          String                    @id @default(cuid())
  name                        String
  email                       String                    @unique
  passwordHash                String
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  memberships                 Membership[]
  sessions                    Session[]
  metaOAuthAttempts           MetaOAuthAttempt[]        @relation("MetaOAuthAttemptUser")
  metaConnections             MetaConnection[]          @relation("MetaConnectionConnectedBy")
  metaConnectionAudits        MetaConnectionAudit[]     @relation("MetaConnectionAuditActor")
  approvals                   Approval[]
  analysisRuns                BusinessAnalysisRun[]     @relation("AnalysisTriggeredBy")
  confirmedBusinessAttributes BusinessAttribute[]       @relation("AttributeConfirmedBy")
  approvedContentPlans        ContentPlan[]             @relation("ContentPlanApprovedBy")
  contentPlanningRuns         ContentPlanningRun[]      @relation("PlanningTriggeredBy")
  dismissedCaptureRequests    CaptureRequest[]          @relation("CaptureRequestDismissedBy")
  acceptedFallbackProposals   ContentFallbackProposal[] @relation("FallbackProposalAcceptedBy")
  triggeredMediaAnalyses      MediaAnalysis[]           @relation("MediaAnalysisTriggeredBy")
  triggeredMediaEnhancements  MediaEnhancement[]        @relation("MediaEnhancementTriggeredBy")
  decidedMediaEnhancements    MediaEnhancement[]        @relation("MediaEnhancementDecidedBy")
  triggeredMediaBrandStyles   MediaBrandStyle[]         @relation("MediaBrandStyleTriggeredBy")
  decidedMediaBrandStyles     MediaBrandStyle[]         @relation("MediaBrandStyleDecidedBy")
  triggeredSocialVariants     MediaSocialVariant[]      @relation("MediaSocialVariantTriggeredBy")
  decidedSocialVariants       MediaSocialVariant[]      @relation("MediaSocialVariantDecidedBy")
  triggeredCreativeCampaigns  MediaCreativeCampaign[]   @relation("MediaCreativeCampaignTriggeredBy")
  decidedCreativeCampaigns    MediaCreativeCampaign[]   @relation("MediaCreativeCampaignDecidedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metaOAuthAttempts MetaOAuthAttempt[]

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id                String                    @id @default(cuid())
  name              String
  sector            String
  location          String?
  website           String?
  instagramHandle   String?
  timezone          String                    @default("Europe/Istanbul")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  memberships       Membership[]
  brandProfile      BrandProfile?
  goals             BusinessGoal[]
  socialAccounts    SocialAccount[]
  mediaAssets       MediaAsset[]
  contentItems      ContentItem[]
  scheduledPosts    ScheduledPost[]
  aiInsights        AIInsight[]
  analysisRuns      BusinessAnalysisRun[]
  attributes        BusinessAttribute[]
  platformRules     PlatformRule[]
  contentStrategy   ContentStrategy?
  contentPlans      ContentPlan[]
  planningRuns      ContentPlanningRun[]
  captureRequests   CaptureRequest[]
  mediaUsages       MediaUsage[]
  fallbackProposals ContentFallbackProposal[]
  mediaAnalyses     MediaAnalysis[]
  mediaEnhancements MediaEnhancement[]
  mediaBrandStyles  MediaBrandStyle[]
  socialVariants    MediaSocialVariant[]
  creativeCampaigns MediaCreativeCampaign[]
  publishIntents    PublishIntent[]
  metaOAuthAttempts MetaOAuthAttempt[]
  metaConnections   MetaConnection[]
  metaConnectionAudits MetaConnectionAudit[]
}

model ContentPlanningRun {
  id            String                   @id @default(cuid())
  businessId    String
  triggeredById String
  period        ContentPlanPeriod
  scope         String
  provider      String
  model         String
  promptVersion String
  inputHash     String
  status        ContentPlanningRunStatus @default(PENDING)
  errorCode     String?
  createdAt     DateTime                 @default(now())
  completedAt   DateTime?
  business      Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  triggeredBy   User                     @relation("PlanningTriggeredBy", fields: [triggeredById], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([triggeredById, createdAt])
}

model PlatformRule {
  id                 String                     @id @default(cuid())
  businessId         String?
  platform           SocialPlatform
  contentType        ContentType?
  category           PlatformRuleCategory
  ruleKey            String
  value              Json
  recommendationType PlatformRecommendationType
  source             PlatformRuleSource
  sourceUrl          String?
  effectiveFrom      DateTime
  expiresAt          DateTime?
  reviewedAt         DateTime
  confidence         Float
  sectorScope        String[]                   @default([])
  active             Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  business           Business?                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialVariants     MediaSocialVariant[]
  creativeCampaigns  MediaCreativeCampaign[]

  @@unique([businessId, platform, contentType, ruleKey, effectiveFrom])
  @@index([platform, active, effectiveFrom])
  @@index([businessId, platform, active])
}

model ContentStrategy {
  id                 String              @id @default(cuid())
  businessId         String              @unique
  mode               ContentStrategyMode @default(AINETRA_RECOMMENDED)
  platformSettings   Json
  contentMix         Json
  languages          String[]
  rationale          String
  userOverrideFields String[]            @default([])
  version            Int                 @default(1)
  approvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plans              ContentPlan[]
}

model ContentPlan {
  id                 String                    @id @default(cuid())
  businessId         String
  strategyId         String
  period             ContentPlanPeriod
  startDate          DateTime
  endDate            DateTime
  timezone           String
  version            Int                       @default(1)
  status             ContentPlanStatus         @default(DRAFT)
  strategySummary    String
  strategySnapshot   Json
  platformStrategies Json
  contentMix         Json
  provider           String
  model              String
  promptVersion      String
  inputHash          String
  approvedAt         DateTime?
  approvedById       String?
  supersedesId       String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  strategy           ContentStrategy           @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  approvedBy         User?                     @relation("ContentPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  supersedes         ContentPlan?              @relation("ContentPlanSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       ContentPlan[]             @relation("ContentPlanSupersession")
  items              ContentPlanItem[]
  fallbackProposals  ContentFallbackProposal[]

  @@unique([businessId, period, startDate, version])
  @@index([businessId, period, status, createdAt])
  @@index([strategyId])
  @@index([approvedById])
  @@index([supersedesId])
}

model ContentPlanItem {
  id                   String                    @id @default(cuid())
  planId               String
  goalId               String
  platform             SocialPlatform
  contentType          ContentType
  plannedDate          DateTime
  recommendedTime      String
  pillar               String
  topic                String
  concept              String
  hookCategory         String
  hook                 String
  captionDirection     String
  cta                  String
  language             String
  mediaRequirement     MediaRequirement
  mediaAvailability    MediaAvailability
  mediaAssetId         String?
  reasoning            String
  platformRulesApplied Json
  revision             Int                       @default(1)
  status               ContentPlanItemStatus     @default(ACTIVE)
  replacesItemId       String?
  contentItemId        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  plan                 ContentPlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal                 BusinessGoal              @relation(fields: [goalId], references: [id], onDelete: Restrict)
  mediaAsset           MediaAsset?               @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  replacesItem         ContentPlanItem?          @relation("ContentPlanItemReplacement", fields: [replacesItemId], references: [id], onDelete: SetNull)
  replacementItems     ContentPlanItem[]         @relation("ContentPlanItemReplacement")
  contentItem          ContentItem?              @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  captureRequests      CaptureRequest[]
  fallbackProposals    ContentFallbackProposal[]

  @@index([planId, status, plannedDate])
  @@index([goalId])
  @@index([mediaAssetId])
  @@index([replacesItemId])
  @@index([contentItemId])
}

model BusinessAnalysisRun {
  id             String                 @id @default(cuid())
  businessId     String
  triggeredById  String?
  provider       String
  model          String
  promptVersion  String
  inputSources   Json
  outputSnapshot Json?
  status         BusinessAnalysisStatus @default(PENDING)
  errorCode      String?
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  triggeredBy    User?                  @relation("AnalysisTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  attributes     BusinessAttribute[]

  @@index([businessId, status, createdAt])
  @@index([triggeredById])
}

model BusinessAttribute {
  id                 String                    @id @default(cuid())
  businessId         String
  analysisRunId      String?
  category           BusinessAttributeCategory
  key                String
  value              Json
  source             BusinessAttributeSource
  sourceReference    String?
  confidence         Float?
  verificationStatus BusinessAttributeStatus
  isCanonical        Boolean                   @default(false)
  supersedesId       String?
  confirmedAt        DateTime?
  confirmedById      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  analysisRun        BusinessAnalysisRun?      @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  supersedes         BusinessAttribute?        @relation("AttributeSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy       BusinessAttribute[]       @relation("AttributeSupersession")
  confirmedBy        User?                     @relation("AttributeConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([businessId, key])
  @@index([businessId, category, verificationStatus])
  @@index([analysisRunId])
  @@index([supersedesId])
  @@index([confirmedById])
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole @default(MEMBER)
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
}

model BrandProfile {
  id                String                  @id @default(cuid())
  businessId        String                  @unique
  description       String                  @default("")
  targetAudience    String                  @default("")
  languages         String[]                @default(["tr"])
  productsSummary   String                  @default("")
  toneDimensions    Json                    @default("{}")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  business          Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // P5-03: bu profilden türetilmiş marka stili çalıştırmaları. Kayıtlar profil sonradan değişse de
  // kendi anlık görüntüsünü (styleProfile/brandProfileUpdatedAt) korur; geçmiş çıktılar değişmez.
  mediaBrandStyles  MediaBrandStyle[]
  // P5-04: bu profilden türetilen kreatif kampanya çalıştırmaları. Her kayıt kendi marka anlık
  // görüntüsünü saklar; profil sonradan değişse de geçmiş çıktı aynı kalır.
  creativeCampaigns MediaCreativeCampaign[]
}

model BusinessGoal {
  id         String            @id @default(cuid())
  businessId String
  type       String
  priority   GoalPriority
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  content    ContentItem[]
  planItems  ContentPlanItem[]

  @@unique([businessId, type])
  @@index([businessId, priority])
}

model SocialAccount {
  id                String              @id @default(cuid())
  businessId        String
  platform          SocialPlatform
  displayName       String
  externalAccountId String?
  status            SocialAccountStatus @default(DISCONNECTED)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scheduledPosts    ScheduledPost[]
  publishIntents    PublishIntent[]
  metaConnection    MetaConnection?
  metaOAuthReconnects MetaOAuthAttempt[] @relation("MetaOAuthReconnectTarget")
  metaConnectionAudits MetaConnectionAudit[]

  // Sağlayıcı kimliği boşsa değil, doluysa (businessId, platform, externalAccountId) benzersizdir; kısmi
  // benzersiz indeks P6-02 migration'ında SQL ile tanımlıdır (legacy null kimlikli satırlar korunur).
  @@index([businessId])
}

model MediaAsset {
  id                       String                    @id @default(cuid())
  businessId               String
  type                     MediaType                 @default(IMAGE)
  originalFilename         String
  mimeType                 String
  size                     Int
  width                    Int?
  height                   Int?
  storageKey               String                    @unique
  tags                     String[]                  @default([])
  // Tek ve belirsizliğe yer bırakmayan "güncel analiz" işaretçisi: yalnızca SUCCEEDED bir
  // MediaAnalysis'i gösterir; başarısız/geçersiz denemeler bu alana asla yazılmaz.
  currentAnalysisId        String?                   @unique
  // P5-02: kaynağı UPLOAD olan satır kullanıcının yüklediği orijinaldir ve değiştirilmez. SAFE_ENHANCE
  // satırı, kullanıcının "Sakla" dediği bir iyileştirme çıktısıdır; derivedFromId kaynağı gösterir.
  origin                   MediaAssetOrigin          @default(UPLOAD)
  derivedFromId            String?
  createdAt                DateTime                  @default(now())
  business                 Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currentAnalysis          MediaAnalysis?            @relation("MediaAssetCurrentAnalysis", fields: [currentAnalysisId], references: [id], onDelete: SetNull)
  derivedFrom              MediaAsset?               @relation("MediaAssetDerivedFrom", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives              MediaAsset[]              @relation("MediaAssetDerivedFrom")
  variants                 ContentVariant[]
  planItems                ContentPlanItem[]
  captureRequestsFulfilled CaptureRequest[]          @relation("CaptureRequestFulfilledBy")
  usages                   MediaUsage[]
  fallbackProposals        ContentFallbackProposal[]
  analyses                 MediaAnalysis[]           @relation("MediaAnalysisAsset")
  enhancements             MediaEnhancement[]        @relation("MediaEnhancementSource")
  enhancementOutputOf      MediaEnhancement?         @relation("MediaEnhancementOutput")
  brandStyles              MediaBrandStyle[]         @relation("MediaBrandStyleSource")
  brandStyleOutputOf       MediaBrandStyle?          @relation("MediaBrandStyleOutput")
  socialVariants           MediaSocialVariant[]      @relation("MediaSocialVariantSource")
  socialVariantRootOf      MediaSocialVariant[]      @relation("MediaSocialVariantRoot")
  socialVariantOutputOf    MediaSocialVariant?       @relation("MediaSocialVariantOutput")
  creativeCampaigns        MediaCreativeCampaign[]   @relation("MediaCreativeCampaignSource")
  creativeCampaignRootOf   MediaCreativeCampaign[]   @relation("MediaCreativeCampaignRoot")
  creativeCampaignOutputOf MediaCreativeCampaign?    @relation("MediaCreativeCampaignOutput")

  @@index([businessId, createdAt])
  @@index([derivedFromId])
}

// Her analiz denemesi (mediaAssetId, version) ile sürümlenir. Güncel analiz MediaAsset.currentAnalysisId
// ile belirlenir; daha yüksek sürümlü bir SUCCEEDED analiz güncel olduğunda önceki supersededAt alır.
// result: sağlayıcı çıktısının şemaya göre doğrulanmış, normalize edilmiş hali (ham yük saklanmaz).
model MediaAnalysis {
  id              String                  @id @default(cuid())
  businessId      String
  mediaAssetId    String
  version         Int
  status          MediaAnalysisStatus     @default(PENDING)
  provider        String
  model           String
  provenance      MediaAnalysisProvenance
  analysisVersion String
  category        VisualCategory?
  result          Json?
  errorCode       String?
  triggeredById   String?
  supersededAt    DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  business        Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset              @relation("MediaAnalysisAsset", fields: [mediaAssetId], references: [id], onDelete: Cascade)
  currentFor      MediaAsset?             @relation("MediaAssetCurrentAnalysis")
  triggeredBy     User?                   @relation("MediaAnalysisTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  enhancements    MediaEnhancement[]      @relation("MediaEnhancementSourceAnalysis")
  brandStyles     MediaBrandStyle[]       @relation("MediaBrandStyleSourceAnalysis")
  socialVariants  MediaSocialVariant[]    @relation("MediaSocialVariantSourceAnalysis")

  @@unique([mediaAssetId, version])
  @@index([businessId, createdAt])
  @@index([triggeredById])
}

// P5-02 Safe Enhance: her deneme (sourceAssetId, version) ile sürümlenir; kaynak MediaAsset satırı ve
// baytları asla değişmez. Başarılı çıktı ayrı bir depolama anahtarında saklanır (outputStorageKey) ve
// yalnızca kullanıcı "Sakla" dediğinde ayrı bir MediaAsset (outputAssetId, origin SAFE_ENHANCE) olur.
// operations: sağlayıcıya verilen, şemayla sınırlandırılmış piksel düzeyi ayarlar (ham yük saklanmaz).
// Aynı kaynak+ön ayar için aynı anda yalnızca bir PENDING deneme olabilir (serviste Serializable denetim).
model MediaEnhancement {
  id                    String                     @id @default(cuid())
  businessId            String
  sourceAssetId         String
  version               Int
  preset                MediaEnhancementPreset
  status                MediaEnhancementStatus     @default(PENDING)
  decision              MediaEnhancementDecision?
  provider              String
  model                 String
  provenance            MediaEnhancementProvenance
  parameterVersion      String
  operations            Json?
  authenticitySensitive Boolean                    @default(true)
  sourceAnalysisId      String?
  outputStorageKey      String?                    @unique
  outputMimeType        String?
  outputSize            Int?
  outputWidth           Int?
  outputHeight          Int?
  outputAssetId         String?                    @unique
  errorCode             String?
  triggeredById         String?
  decidedById           String?
  decidedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceAsset           MediaAsset                 @relation("MediaEnhancementSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  outputAsset           MediaAsset?                @relation("MediaEnhancementOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)
  sourceAnalysis        MediaAnalysis?             @relation("MediaEnhancementSourceAnalysis", fields: [sourceAnalysisId], references: [id], onDelete: SetNull)
  triggeredBy           User?                      @relation("MediaEnhancementTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  decidedBy             User?                      @relation("MediaEnhancementDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  brandStyles    MediaBrandStyle[]    @relation("MediaBrandStyleSourceEnhancement")
  socialVariants MediaSocialVariant[] @relation("MediaSocialVariantSourceEnhancement")

  @@unique([sourceAssetId, version])
  @@index([businessId, createdAt])
  @@index([sourceAssetId, preset, status])
  @@index([triggeredById])
  @@index([decidedById])
}

// P5-03 Marka Stili: her deneme (sourceAssetId, version) ile sürümlenir. Kaynak, kullanıcının yüklediği
// orijinal ya da saklanmış bir Safe Enhance türevi olabilir; her iki satır ve baytları da asla değişmez.
// sourceEnhancementId kaynak Safe Enhance soyunu açıkça kaydeder. Bir marka stili çıktısı yeniden
// stillendirilemez (belirsiz zincir oluşmaz). styleProfile/brandProfileUpdatedAt, çalıştırma anındaki
// marka tercihlerinin anlık görüntüsüdür: BrandProfile sonradan değişse de geçmiş kayıtlar aynı kalır.
// operations: P5-02'nin kapalı piksel sözleşmesine göre doğrulanmış, özgünlük katmanına göre daraltılmış set.
model MediaBrandStyle {
  id                    String                          @id @default(cuid())
  businessId            String
  sourceAssetId         String
  sourceEnhancementId   String?
  version               Int
  choice                MediaBrandStyleChoice
  status                MediaBrandStyleStatus           @default(PENDING)
  decision              MediaBrandStyleDecision?
  provider              String
  model                 String
  provenance            MediaBrandStyleProvenance
  styleVersion          String
  profileVersion        String
  brandProfileId        String?
  brandProfileUpdatedAt DateTime?
  styleProfile          Json?
  operations            Json?
  authenticityTier      MediaBrandStyleAuthenticityTier @default(STRICT)
  authenticitySensitive Boolean                         @default(true)
  sourceAnalysisId      String?
  outputStorageKey      String?                         @unique
  outputMimeType        String?
  outputSize            Int?
  outputWidth           Int?
  outputHeight          Int?
  outputAssetId         String?                         @unique
  errorCode             String?
  triggeredById         String?
  decidedById           String?
  decidedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  business              Business                        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceAsset           MediaAsset                      @relation("MediaBrandStyleSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  sourceEnhancement     MediaEnhancement?               @relation("MediaBrandStyleSourceEnhancement", fields: [sourceEnhancementId], references: [id], onDelete: SetNull)
  outputAsset           MediaAsset?                     @relation("MediaBrandStyleOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)
  sourceAnalysis        MediaAnalysis?                  @relation("MediaBrandStyleSourceAnalysis", fields: [sourceAnalysisId], references: [id], onDelete: SetNull)
  brandProfile          BrandProfile?                   @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  triggeredBy           User?                           @relation("MediaBrandStyleTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  decidedBy             User?                           @relation("MediaBrandStyleDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  socialVariants        MediaSocialVariant[]            @relation("MediaSocialVariantSourceBrandStyle")

  @@unique([sourceAssetId, version])
  @@index([businessId, createdAt])
  @@index([sourceAssetId, choice, status])
  @@index([sourceEnhancementId])
  @@index([brandProfileId])
  @@index([triggeredById])
  @@index([decidedById])
}

model ContentItem {
  id          String            @id @default(cuid())
  businessId  String
  goalId      String?
  title       String
  topic       String
  contentType ContentType
  status      ContentStatus     @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  goal        BusinessGoal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  variants    ContentVariant[]
  planItems   ContentPlanItem[]

  @@index([businessId, createdAt])
}

model ContentVariant {
  id              String          @id @default(cuid())
  contentItemId   String
  platform        SocialPlatform
  caption         String
  cta             String?
  language        String          @default("tr")
  mediaAssetId    String?
  aspectRatio     String?
  formatMetadata  Json            @default("{}")
  version         Int             @default(1)
  exportedAt      DateTime?
  exportedVersion Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contentItem     ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  approvals       Approval[]
  scheduledPosts  ScheduledPost[]
  mediaUsages     MediaUsage[]
  publishIntents  PublishIntent[]

  @@unique([contentItemId, platform])
  @@index([mediaAssetId])
}

model Approval {
  id               String         @id @default(cuid())
  contentVariantId String
  approvedVersion  Int
  approvedById     String
  approvedAt       DateTime       @default(now())
  contentVariant   ContentVariant @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)
  approvedBy       User           @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  publishIntents   PublishIntent[]

  @@unique([contentVariantId, approvedVersion])
  @@index([approvedById])
}

model ScheduledPost {
  id               String              @id @default(cuid())
  businessId       String
  socialAccountId  String
  contentVariantId String
  contentVersion   Int
  scheduledAt      DateTime
  status           ScheduledPostStatus @default(SCHEDULED)
  invalidatedAt    DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  contentVariant   ContentVariant      @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)
  publishAttempts  PublishAttempt[]
  publishIntents   PublishIntent[]
  performance      PostPerformance?

  @@index([businessId, scheduledAt])
  @@index([status, scheduledAt])
}

model PublishAttempt {
  id                String               @id @default(cuid())
  scheduledPostId   String
  status            PublishAttemptStatus @default(PENDING)
  errorCode         String?
  errorMessage      String?
  attemptedAt       DateTime             @default(now())
  // P6-01: aşağıdaki alanlar boş olabilir; P6-01 öncesi satırlar olduğu gibi geçerli kalır.
  publishIntentId   String?
  attemptNumber     Int?
  outcome           PublishOutcomeClass?
  providerReference String?
  // Yalnızca redakte edilmiş teşhis bilgisi; token/secret asla yazılmaz.
  diagnostics       Json?
  completedAt       DateTime?
  // P6-03: denemeyi yürüten adaptör ve Instagram konteyner kimliği (nihai gönderi kimliği değildir;
  // nihai Meta gönderi/medya kimliği providerReference alanındadır).
  adapterKey          String?
  adapterVersion      Int?
  providerContainerId String?
  // P6-04: ilk gerçek yayın çağrısından (FB /feed, /photos; IG /media_publish) hemen ÖNCE, aynı canlı
  // kiralamaya karşı karşılaştır-ve-yaz ile yazılır. Boşsa ve deneme korumalı protokolle oluşturulduysa
  // yayın çağrısı başlamamıştır; doluysa sonuç belirsiz sayılır ve otomatik yeniden gönderilmez.
  publishCallStartedAt DateTime?
  scheduledPost     ScheduledPost        @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  publishIntent     PublishIntent?       @relation(fields: [publishIntentId], references: [id], onDelete: Cascade)

  @@unique([publishIntentId, attemptNumber])
  @@index([scheduledPostId, attemptedAt])
}

// P6-01: Ainetra'nın PostgreSQL outbox satırı (ikinci bir kuyruk tablosu yok). Onaylı güncel sürümün
// değişmez anlık görüntüsünü (snapshot) ve deterministik özetini taşır. Sonraki içerik düzenlemeleri
// snapshot'ı yeniden yazmaz; gönderilmemiş intent'i gönderilemez hale getirir.
model PublishIntent {
  id                String             @id @default(cuid())
  businessId        String
  socialAccountId   String
  scheduledPostId   String
  sourceVariantId   String
  sourceVersion     Int
  approvalId        String
  platform          SocialPlatform
  dueAt             DateTime
  adapterKey        String
  adapterVersion    Int
  generation        Int                @default(1)
  idempotencyKey    String             @unique
  snapshotVersion   Int
  snapshot          Json
  snapshotHash      String
  state             PublishIntentState @default(PENDING)
  stateChangedAt    DateTime           @default(now())
  leaseExpiresAt    DateTime?
  invalidatedAt     DateTime?
  providerReference String?
  providerEvidence  Json?
  publishedAt       DateTime?
  // P6-03: IN_FLIGHT kiralamasını kazanan tek deneme. Sonuç yalnızca bu denemeyle karşılaştır-ve-yaz ile kaydedilir.
  currentAttemptId  String?            @unique
  // P6-04: RETRY_WAIT için bir sonraki otomatik deneme zamanı (veritabanı saatiyle). Boşsa worker otomatik
  // yeniden denemez; deneme sayısı numaralı PublishAttempt satırlarından türetilir.
  nextAttemptAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  scheduledPost     ScheduledPost      @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  sourceVariant     ContentVariant     @relation(fields: [sourceVariantId], references: [id], onDelete: Cascade)
  approval          Approval           @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  attempts          PublishAttempt[]

  @@unique([scheduledPostId, generation])
  @@index([state, dueAt])
  @@index([state, nextAttemptAt])
  @@index([state, leaseExpiresAt])
  @@index([businessId, createdAt])
  @@index([socialAccountId])
  @@index([sourceVariantId])
  @@index([approvalId])
}

model PostPerformance {
  id              String        @id @default(cuid())
  scheduledPostId String        @unique
  impressions     Int?
  engagements     Int?
  capturedAt      DateTime      @default(now())
  scheduledPost   ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id         String   @id @default(cuid())
  businessId String
  kind       String
  message    String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model CaptureRequest {
  id                      String               @id @default(cuid())
  businessId              String
  contentPlanItemId       String
  mediaRequirement        MediaRequirement
  requestedMediaType      MediaType
  title                   String
  instructions            String
  dueAt                   DateTime
  status                  CaptureRequestStatus @default(OPEN)
  fulfilledByMediaAssetId String?
  fulfilledAt             DateTime?
  dismissedById           String?
  dismissedAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  business                Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contentPlanItem         ContentPlanItem      @relation(fields: [contentPlanItemId], references: [id], onDelete: Cascade)
  fulfilledByMedia        MediaAsset?          @relation("CaptureRequestFulfilledBy", fields: [fulfilledByMediaAssetId], references: [id], onDelete: SetNull)
  dismissedBy             User?                @relation("CaptureRequestDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  // Dedup anahtarı: aynı plan öğesi + aynı medya ihtiyacı için tek satır.
  // Uygulama katmanı FULFILLED->OPEN yeniden açılışını (medya silinirse) yönetir;
  // DISMISSED/EXPIRED asla otomatik yeniden açılmaz (bkz. capture-engine/service.ts).
  @@unique([contentPlanItemId, mediaRequirement])
  @@index([businessId, status, dueAt])
  @@index([fulfilledByMediaAssetId])
}

model MediaUsage {
  id               String            @id @default(cuid())
  businessId       String
  mediaAssetId     String
  contentVariantId String
  platform         SocialPlatform
  contentType      ContentType
  usageType        MediaUsageType
  mediaRequirement MediaRequirement?
  usedAt           DateTime          @default(now())
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset        @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  contentVariant   ContentVariant    @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)

  // Mantıksal kullanım anahtarı: aynı varyantta aynı medyanın aynı türde kullanımı tek satırdır.
  // Eşzamanlı kayıt denemeleri ON CONFLICT DO NOTHING ile tek satıra düşer (bkz. media-usage/service.ts).
  @@unique([contentVariantId, mediaAssetId, usageType])
  @@index([businessId, mediaAssetId, usedAt])
  @@index([contentVariantId])
}

// P4-04 Content Fallback: medyası eksik bir plan öğesi için üretilen, kullanıcı KABUL EDENE
// kadar planı değiştirmeyen öneri. Öneri; hangi plan sürümü ve öğe revizyonu için üretildiğini
// taşır; kabul anında bu bilgiler yeniden doğrulanır (bkz. content-fallback/service.ts).
model ContentFallbackProposal {
  id                     String                        @id @default(cuid())
  businessId             String
  planId                 String
  planVersion            Int
  contentPlanItemId      String
  itemRevision           Int
  kind                   ContentFallbackKind
  mediaAssetId           String?
  targetMediaRequirement MediaRequirement
  rationale              String
  sources                Json
  fingerprint            String
  status                 ContentFallbackProposalStatus @default(PROPOSED)
  acceptedAt             DateTime?
  acceptedById           String?
  invalidatedAt          DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  business               Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan                   ContentPlan                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  contentPlanItem        ContentPlanItem               @relation(fields: [contentPlanItemId], references: [id], onDelete: Cascade)
  mediaAsset             MediaAsset?                   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  acceptedBy             User?                         @relation("FallbackProposalAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([contentPlanItemId, status])
  @@index([businessId, status, createdAt])
  @@index([planId])
  @@index([mediaAssetId])
  @@index([acceptedById])
}

// P5-04 Sosyal Varyant: kabul edilmiş özgün bir görselden, mevcut Platform Intelligence oran kuralına
// göre üretilen TEKNİK format türevi. Her deneme (sourceAssetId, version) ile sürümlenir; kaynak satır
// ve baytları hiçbir yolda değişmez. Çıktı ayrı bir anahtara yazılır ve yalnızca kullanıcı "Sakla"
// dediğinde ayrı bir MediaAsset (origin SOCIAL_VARIANT) olur.
//
// Kural provenansı kayda geçer: ruleId/ruleKey/ruleEffectiveFrom ve kuralın anlık görüntüsü. Teknik
// platform gereksinimi burada ÇOĞALTILMAZ veya UYDURULMAZ; yalnızca okunan kural saklanır.
// Soy: sourceAssetId doğrudan kaynak, rootAssetId ise zincirin en başındaki yüklenen orijinaldir.
// Aynı (kaynak, platform, format) için aynı anda tek aktif deneme olabilir; karar verilmiş bir
// istek yeniden çalıştırıldığında yeni bir sürüm açılır ve geçmiş olduğu gibi kalır.
model MediaSocialVariant {
  id                  String                       @id @default(cuid())
  businessId          String
  sourceAssetId       String
  rootAssetId         String?
  sourceEnhancementId String?
  sourceBrandStyleId  String?
  sourceAnalysisId    String?
  version             Int
  platform            SocialPlatform
  contentType         ContentType
  format              MediaSocialVariantFormat
  status              MediaSocialVariantStatus     @default(PENDING)
  decision            MediaSocialVariantDecision?
  provider            String
  model               String
  provenance          MediaSocialVariantProvenance
  variantVersion      String
  ruleId              String?
  ruleKey             String
  ruleEffectiveFrom   DateTime
  ruleSnapshot        Json
  targetAspectRatio   String
  fit                 MediaSocialVariantFit
  // Güvenli kırpma kurulamadığı için fotoğrafın tamamı korundu; kullanıcı sonucu mutlaka görmeli.
  reviewNeeded        Boolean                      @default(false)
  operations          Json?
  outputStorageKey    String?                      @unique
  outputMimeType      String?
  outputSize          Int?
  outputWidth         Int?
  outputHeight        Int?
  outputAssetId       String?                      @unique
  errorCode           String?
  triggeredById       String?
  decidedById         String?
  decidedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  business            Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceAsset         MediaAsset                   @relation("MediaSocialVariantSource", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  rootAsset           MediaAsset?                  @relation("MediaSocialVariantRoot", fields: [rootAssetId], references: [id], onDelete: SetNull)
  outputAsset         MediaAsset?                  @relation("MediaSocialVariantOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)
  sourceEnhancement   MediaEnhancement?            @relation("MediaSocialVariantSourceEnhancement", fields: [sourceEnhancementId], references: [id], onDelete: SetNull)
  sourceBrandStyle    MediaBrandStyle?             @relation("MediaSocialVariantSourceBrandStyle", fields: [sourceBrandStyleId], references: [id], onDelete: SetNull)
  sourceAnalysis      MediaAnalysis?               @relation("MediaSocialVariantSourceAnalysis", fields: [sourceAnalysisId], references: [id], onDelete: SetNull)
  rule                PlatformRule?                @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  triggeredBy         User?                        @relation("MediaSocialVariantTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  decidedBy           User?                        @relation("MediaSocialVariantDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([sourceAssetId, version])
  @@index([businessId, createdAt])
  @@index([sourceAssetId, platform, format, status])
  @@index([rootAssetId])
  @@index([sourceEnhancementId])
  @@index([sourceBrandStyleId])
  @@index([ruleId])
  @@index([triggeredById])
  @@index([decidedById])
}

// P5-04 Kreatif Kampanya: açıkça TASARIM olarak tanımlanan, bilgilendirici bir görsel. Sosyal
// Varyant tablosundan ayrıdır çünkü ayrı bir üründür: teknik türev değil, kurgulanmış tasarım.
//
// copy yalnızca factRefs içindeki kanonik ve ONAYLI Business Brain bilgilerinden kurulur; kampanya,
// indirim, fiyat, ürün, hizmet, etkinlik, saat, yorum, manzara, uygunluk veya teklif koşulu
// uydurulmaz. factRefs/copy/brandSnapshot/ruleSnapshot birer anlık görüntüdür: bilgi, kural, metin
// veya marka tercihi sonradan değişse de geçmiş çıktı aynı kalır.
// sourceAssetId yalnızca kabul edilmiş gerçek bir medya kullanıldığında dolar; çıktı yine de tasarım
// olarak işaretlenir ve yalnızca CUSTOM_GRAPHIC planlama etiketi alabilir.
model MediaCreativeCampaign {
  id                    String                   @id @default(cuid())
  businessId            String
  version               Int
  category              MediaCreativeCategory
  status                MediaCreativeStatus      @default(PENDING)
  decision              MediaCreativeDecision?
  provider              String
  model                 String
  provenance            MediaCreativeProvenance
  creativeVersion       String
  platform              SocialPlatform
  contentType           ContentType
  format                MediaSocialVariantFormat
  ruleId                String?
  ruleKey               String
  ruleEffectiveFrom     DateTime
  ruleSnapshot          Json
  targetAspectRatio     String
  factRefs              Json
  copy                  Json
  brandProfileId        String?
  brandProfileUpdatedAt DateTime?
  brandSnapshot         Json
  sourceAssetId         String?
  rootAssetId           String?
  outputStorageKey      String?                  @unique
  outputMimeType        String?
  outputSize            Int?
  outputWidth           Int?
  outputHeight          Int?
  outputAssetId         String?                  @unique
  errorCode             String?
  triggeredById         String?
  decidedById           String?
  decidedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sourceAsset           MediaAsset?              @relation("MediaCreativeCampaignSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  rootAsset             MediaAsset?              @relation("MediaCreativeCampaignRoot", fields: [rootAssetId], references: [id], onDelete: SetNull)
  outputAsset           MediaAsset?              @relation("MediaCreativeCampaignOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)
  brandProfile          BrandProfile?            @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  rule                  PlatformRule?            @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  triggeredBy           User?                    @relation("MediaCreativeCampaignTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  decidedBy             User?                    @relation("MediaCreativeCampaignDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([businessId, version])
  @@index([businessId, createdAt])
  @@index([businessId, category, status])
  @@index([sourceAssetId])
  @@index([rootAssetId])
  @@index([brandProfileId])
  @@index([ruleId])
  @@index([triggeredById])
  @@index([decidedById])
}

/// P6-02: tek kullanımlık Meta OAuth denemesi (CONNECTING). Yalnızca state/seçim tutamacının hash'i saklanır.
/// Seçim bekleyen Page kimlik bilgileri şifreli, kısa ömürlü ve bu denemeye bağlıdır; seçimde, hatada veya
/// süre dolduğunda silinir.
model MetaOAuthAttempt {
  id                       String                 @id @default(cuid())
  businessId               String
  userId                   String
  sessionId                String
  stateHash                String                 @unique
  status                   MetaOAuthAttemptStatus @default(PENDING)
  reconnectSocialAccountId String?
  expiresAt                DateTime
  consumedAt               DateTime?
  selectionHandleHash      String?                @unique
  selectionExpiresAt       DateTime?
  candidates               Json?
  grantedScopes            String[]               @default([])
  pendingCiphertext        Bytes?
  pendingNonce             Bytes?
  pendingAuthTag           Bytes?
  pendingKeyId             String?
  completedAt              DateTime?
  failedAt                 DateTime?
  failureCode              String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  business                 Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user                     User                   @relation("MetaOAuthAttemptUser", fields: [userId], references: [id], onDelete: Cascade)
  session                  Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reconnectSocialAccount   SocialAccount?         @relation("MetaOAuthReconnectTarget", fields: [reconnectSocialAccountId], references: [id], onDelete: SetNull)
  audits                   MetaConnectionAudit[]

  @@index([businessId, createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

/// P6-02: seçilen SocialAccount için Ainetra'ya ait Meta bağlantı meta verisi ve şifreli kimlik bilgisi sınırı.
/// Şifreli metin/nonce/tag/anahtar sürümü yalnızca sunucuda okunur; ham token hiçbir zaman saklanmaz.
model MetaConnection {
  id                  String         @id @default(cuid())
  businessId          String
  socialAccountId     String         @unique
  platform            SocialPlatform
  providerAccountId   String
  metaPageId          String
  instagramAccountId  String?
  pageName            String
  instagramUsername   String?
  grantedScopes       String[]       @default([])
  pageTasks           String[]       @default([])
  tokenType           String?
  credentialRef       String?        @unique
  ciphertext          Bytes?
  nonce               Bytes?
  authTag             Bytes?
  keyId               String?
  tokenExpiresAt      DateTime?
  dataAccessExpiresAt DateTime?
  connectedAt         DateTime
  lastValidatedAt     DateTime?
  reauthRequiredAt    DateTime?
  reauthReason        String?
  disconnectedAt      DateTime?
  providerRevocation  String?
  connectedByUserId   String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount       SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  connectedBy         User?          @relation("MetaConnectionConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  // Aynı Meta varlığının yalnızca bir canlı eşlemesi olabilir; kısmi benzersiz indeks migration'dadır.
  @@index([businessId])
  @@index([platform, providerAccountId])
}

/// P6-02: bağlantı denetim izi. Yalnızca kapalı eylem/sonuç kodları; token, kod veya ham sağlayıcı yükü yok.
model MetaConnectionAudit {
  id              String                    @id @default(cuid())
  businessId      String
  socialAccountId String?
  attemptId       String?
  actorUserId     String?
  action          MetaConnectionAuditAction
  result          String
  reason          String?
  createdAt       DateTime                  @default(now())
  business        Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount?            @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  attempt         MetaOAuthAttempt?         @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  actor           User?                     @relation("MetaConnectionAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([socialAccountId])
  @@index([attemptId])
}
